<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="580.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ezone.pae.proyectocrudg3.controller.ProductosController">
    <children>
        <Label layoutX="20.0" layoutY="16.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Gestión de productos" />

        <Label layoutX="20.0" layoutY="52.0" text="Código" />
        <TextField fx:id="txtCodigo" layoutX="95.0" layoutY="47.0" prefHeight="26.0" prefWidth="145.0" promptText="Ej: PRO-021" />

        <Label layoutX="20.0" layoutY="84.0" text="Precio" />
        <TextField fx:id="txtPrecio" layoutX="95.0" layoutY="79.0" prefHeight="26.0" prefWidth="145.0" promptText="0.00" />

        <Label layoutX="20.0" layoutY="116.0" text="Categoría" />
        <ComboBox fx:id="cmbCategoria" layoutX="95.0" layoutY="111.0" prefHeight="26.0" prefWidth="145.0" />

        <Label layoutX="20.0" layoutY="148.0" text="Fecha" />
        <DatePicker fx:id="dpFechaCreacion" layoutX="95.0" layoutY="143.0" prefHeight="26.0" prefWidth="145.0" />

        <Label layoutX="275.0" layoutY="52.0" text="Nombre" />
        <TextField fx:id="txtNombre" layoutX="340.0" layoutY="47.0" prefHeight="26.0" prefWidth="170.0" promptText="Nombre del producto" />

        <Label layoutX="275.0" layoutY="84.0" text="Stock" />
        <TextField fx:id="txtStock" layoutX="340.0" layoutY="79.0" prefHeight="26.0" prefWidth="170.0" promptText="0" />

        <Label layoutX="275.0" layoutY="116.0" text="Marca" />
        <ComboBox fx:id="cmbMarca" layoutX="340.0" layoutY="111.0" prefHeight="26.0" prefWidth="170.0" />

        <Label layoutX="275.0" layoutY="148.0" text="Descripción" />
        <TextField fx:id="txtDescripcion" layoutX="340.0" layoutY="143.0" prefHeight="26.0" prefWidth="170.0" promptText="Descripción opcional" />

        <HBox layoutX="20.0" layoutY="182.0" spacing="6.0">
            <children>
                <Button fx:id="btnNuevo" mnemonicParsing="false" onAction="#agregarProducto" text="Nuevo" />
                <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarProducto" text="Guardar" />
                <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#actualizarProducto" text="Actualizar" />
                <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarProducto" text="Eliminar" />
            </children>
        </HBox>

        <Separator layoutX="20.0" layoutY="222.0" prefWidth="760.0" />

        <Label layoutX="20.0" layoutY="240.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Búsqueda y filtros" />

        <Label layoutX="20.0" layoutY="276.0" text="Código o nombre" />
        <TextField fx:id="txtFiltroTexto" layoutX="125.0" layoutY="271.0" prefHeight="26.0" prefWidth="155.0" promptText="Buscar..." />

        <Label layoutX="300.0" layoutY="276.0" text="Categoría" />
        <ComboBox fx:id="cmbFiltroCategoria" layoutX="375.0" layoutY="271.0" prefHeight="26.0" prefWidth="145.0" />

        <Label layoutX="20.0" layoutY="308.0" text="Desde" />
        <DatePicker fx:id="dpFiltroDesde" layoutX="125.0" layoutY="303.0" prefHeight="26.0" prefWidth="155.0" />

        <Label layoutX="300.0" layoutY="308.0" text="Hasta" />
        <DatePicker fx:id="dpFiltroHasta" layoutX="375.0" layoutY="303.0" prefHeight="26.0" prefWidth="145.0" />

        <Label layoutX="20.0" layoutY="340.0" text="Precio mínimo" />
        <TextField fx:id="txtPrecioMin" layoutX="125.0" layoutY="335.0" prefHeight="26.0" prefWidth="155.0" promptText="0.00" />

        <Label layoutX="300.0" layoutY="340.0" text="Precio máximo" />
        <TextField fx:id="txtPrecioMax" layoutX="400.0" layoutY="335.0" prefHeight="26.0" prefWidth="120.0" promptText="0.00" />

        <CheckBox fx:id="chkConStock" layoutX="20.0" layoutY="373.0" mnemonicParsing="false" text="Solo productos con existencia" />

        <Label layoutX="300.0" layoutY="373.0" text="Ordenar por" />
        <ComboBox fx:id="cmbOrden" layoutX="375.0" layoutY="368.0" prefHeight="26.0" prefWidth="145.0" promptText="Seleccionar" />

        <HBox layoutX="20.0" layoutY="406.0" spacing="6.0">
            <children>
                <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscarProductos" text="Buscar" />
                <Button fx:id="btnLimpiarFiltros" mnemonicParsing="false" onAction="#limpiarFiltros" text="Limpiar filtros" />
            </children>
        </HBox>

        <TableView fx:id="tblProductos" layoutX="20.0" layoutY="446.0" prefHeight="115.0" prefWidth="760.0">
            <placeholder>
                <Label text="Tabla sin contenido" />
            </placeholder>
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="80.0" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="135.0" text="Nombre" />
                <TableColumn fx:id="colCategoria" prefWidth="110.0" text="Categoría" />
                <TableColumn fx:id="colMarca" prefWidth="100.0" text="Marca" />
                <TableColumn fx:id="colPrecio" prefWidth="80.0" text="Precio" />
                <TableColumn fx:id="colStock" prefWidth="70.0" text="Stock" />
                <TableColumn fx:id="colFecha" prefWidth="180.0" text="Fecha creación" />
            </columns>
        </TableView>
    </children>
</AnchorPane>
